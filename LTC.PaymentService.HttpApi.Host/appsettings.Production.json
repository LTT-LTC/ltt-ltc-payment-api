{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://*:8080",
                "Protocols": "Http1AndHttp2"
            }
        }
    },
    "ConnectionStrings": {
        "Default": "Server=ltt-ltc-sqlserver,1433;Database=LTC_Payment;User Id=sa;Password=MyPassword123.;Encrypt=False;TrustServerCertificate=True",
        "AbpTenantManagement": "Server=ltt-ltc-sqlserver,1433;Database=LTC_Administration;User Id=sa;Password=MyPassword123.;Encrypt=False;TrustServerCertificate=True"
    },
    "Redis": {
        "Configuration": "ltt-ltc-redis:6379"
    },
    "Kafka": {
        "BootstrapServers": "ltt-ltc-kafka:29092",
        "Topics": {
            "BookingRequested": "ltc.booking.requested",
            "BookingRequestedDlq": "ltc.booking.requested.dlq"
        },
        "Producer": {
            "Acks": "all",
            "EnableIdempotence": true
        },
        "Consumer": {
            "GroupId": "payment-booking-consumer",
            "AutoOffsetReset": "Earliest",
            "EnableAutoCommit": false
        }
    },
    "RemoteServices": {
        "AdministrationService": {
            "BaseUrl": "http://ltt-ltc-administration-api:8080"
        },
        "CustomerService": {
            "BaseUrl": "http://ltt-ltc-customer-api:8080"
        },
        "MovieService": {
            "BaseUrl": "http://ltt-ltc-movie-api:8080"
        },
        "NotificationService": {
            "BaseUrl": "http://ltt-ltc-notification-api:8080"
        }
    }
}
